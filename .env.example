# Polygon.io API key for market data (required)
MASSIVE_API_KEY=your_polygon_api_key_here

# AI backend API keys (at least one required for AI screener)
CLAUDE_API_KEY=sk-ant-your_claude_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
PERPLEXITY_API_KEY=pplx-your_perplexity_api_key_here

# Finviz Elite authentication key (optional, falls back to free tier)
FINVIZ_AUTH_KEY=your_finviz_elite_key_here

# Finviz screener URL with custom filters (optional)
# FINVIZ_SCREENER_URL=https://finviz.com/screener.ashx?v=111&f=sh_avgvol_o100,sh_price_u20,sh_relvol_o1.5

# Manual watchlist of ticker symbols (optional, comma-separated)
# MANUAL_WATCHLIST=AAPL,TSLA,NVDA

# Database configuration (optional)
# DB_TYPE=sqlite
# DB_PATH=./falcon_screener.db
